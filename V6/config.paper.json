{
  "mode": "paper",
  "min_arr": 0,
  "min_edge_pct": 0.001,
  "max_contracts": 1000,
  "scan_interval_seconds": 2,
  "print_market_status": true,
  "skip_multi_outcome": false,
  "exit_enabled": true,
  "exit_target_total_price": 0.99,
  "position_file": "open_positions.json",
  "pairs_per_cycle": 10,
  "max_workers": 6,
  "pairs_file": "matched_sports_pairs.csv",
  "entry_log": "entry_trades.json",
  "exit_log": "exit_trades.json",
  "opportunities_log": "opportunities.json",
  "failed_log": "failed_pairs.json",
  "expired_log": "expired_pairs.json",
  "bad_log": "bad_pairs.json",
  "fees": {
    "kalshi": {
      "formula": "p * (1 - p) * 0.07 * c",
      "round_up_to_cent": true
    },
    "polymarket": {
      "formula": "p * (1 - p) * 0 * c"
    }
  },
  "api": {
    "kalshi_base_url": "https://api.elections.kalshi.com/trade-api/v2",
    "polymarket_clob_url": "https://clob.polymarket.com",
    "polymarket_gamma_url": "https://gamma-api.polymarket.com"
  },
  "kalshi": {
    "api_key": "",
    "private_key_base64": ""
  },
  "polymarket": {
    "private_key": "",
    "api_key": "",
    "api_secret": "",
    "api_passphrase": ""
  }
}
