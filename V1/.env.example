# Target Configuration
TARGET_USER_ADDRESS=0xYOUR_TARGET_WALLET_ADDRESS
MY_PROXY_WALLET_ADDRESS=0xYOUR_PROXY_WALLET_ADDRESS

# Wallet Configuration
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Smart Contract Addresses (Polygon Mainnet - do not change)
CTF_ADDRESS=0x4D97DCd97eC945f40cF65F87097ACe5EA0476045
CTF_EXCHANGE_ADDRESS=0x4bFb41d5B3570DeFd03C39a9A4D8dE6Bd8B8982E
NEG_RISK_ADAPTER_ADDRESS=0xd91E80cF2E7be2e162c6513ceD06f1dD0dA35296
NEG_RISK_CTF_EXCHANGE_ADDRESS=0xC5d563A36AE78145C45a50134d48A1215220f80a
USDC_CONTRACT_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174

# API Endpoints
CLOB_HTTP_URL=https://clob.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com
DATA_API_URL=https://data-api.polymarket.com

# Gas Configuration
GAS_LIMIT=5000000
GAS_PRICE_LIMIT=110000000000

# Bot Configuration
WAITING_TIME=4
MAX_POSITION_LIMIT=0.2
BLACKLISTED_MARKETS=

# Arbitrage Execution Engine
ARB_EXECUTION_MODE=PAPER
ARB_AUTO_EXECUTE=false
ARB_BANKROLL_USD=10000
ARB_MIN_NET_EDGE=0.005
ARB_DEFAULT_TICK_SIZE=0.01

# Kalshi Execution (only needed for LIVE Kalshi orders)
KALSHI_API_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_API_KEY=
KALSHI_API_SECRET=
KALSHI_API_PASSPHRASE=
KALSHI_BEARER_TOKEN=
KALSHI_ORDER_ENDPOINT=
KALSHI_USE_MAKER_FEES=false

# Embedding Re-Ranker (optional — improves cross-platform market matching accuracy)
OPENAI_API_KEY=

# Infrastructure
RPC_URL=https://polygon-mainnet.infura.io/v3/YOUR_PROJECT_ID
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/polymarket-bot
